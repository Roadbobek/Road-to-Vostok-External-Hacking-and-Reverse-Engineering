    <CheatEntry>
      <ID>49</ID>
      <Description>"get pointer for viewport stuff"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{ Game   : Road to Vostok
  Version:
  Date   : 2026-07-28
  Author : Roadb
  Description :

  &lt;Optional info&gt;
}



[ENABLE]

// perform an array of bytes search inside the memory module RTV.exe
// the INJECT variable holds the starting memory address for our scan (RTV.exe+125FD10, but can change on update)
aobscanmodule(INJECT,RTV.exe,44 89 42 08 44 89 4A 0C C6 42 14 01 C3 00) // should be unique
alloc(newmem,$1000,INJECT)

label(code)
label(return)

newmem:

code:
  mov [rdx+08],r8d
  mov [rdx+0C],r9d
  jmp return

INJECT:
  jmp newmem
  nop 3
return:
registersymbol(INJECT)

[DISABLE]

INJECT:
  db 44 89 42 08 44 89 4A 0C

unregistersymbol(INJECT)
dealloc(newmem)



{
